{
  "name": "retroconnect",
  "productName": "RetroConnect",
  "version": "0.7.6",
  "description": "Play RetroArch netplay with a friend: the host's exact core and ROM are synced to the guest automatically.",
  "main": "src/main/main.js",
  "author": {
    "name": "phantomdenied",
    "email": "phantomdenied@users.noreply.github.com"
  },
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win --x64",
    "update-feed": "node scripts/update-feed.js"
  },
  "dependencies": {
    "7zip-bin": "5.2.0",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "@fontsource/orbitron": "^5.3.0",
    "@fontsource/press-start-2p": "^5.3.0",
    "@fontsource/vt323": "^5.3.0",
    "electron": "44.7.2",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "io.github.phantomdenied.retroconnect",
    "productName": "RetroConnect",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup.${ext}"
    },
    "publish": null,
    "portable": {
      "artifactName": "${productName}-Portable.${ext}"
    },
    "asarUnpack": [
      "node_modules/7zip-bin/**"
    ]
  },
  "homepage": "https://github.com/phantomdenied/RetroConnect",
  "retroconnect": {
    "githubRepo": "phantomdenied/RetroConnect",
    "updateFeedUrl": ""
  }
}
